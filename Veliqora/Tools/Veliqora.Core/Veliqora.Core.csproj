<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity-independent core (Assets/_Veliqora/Scripts/Core) outside Unity.
       netstandard2.1 + C# 9 mirrors Unity 6's API/language surface to catch incompatibilities early. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Veliqora.Core</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Veliqora/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
