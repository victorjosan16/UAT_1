rules_version = '2';

// Cloud Functions (Admin SDK, bypasses these rules) would be the ideal write
// path for everything, but that needs the Blaze plan and isn't deployed —
// see docs/SECURITY.md. Until then, the leaderboard and player profile are
// written directly from the client (LeaderboardService/PlayerService), so
// THESE rules are the only validation those writes get: signed-in, own uid
// only, one bounded-shape doc per player per collection. This is a
// deliberate, accepted tradeoff (no server-side score re-derivation) — a
// determined client could still write a fake-but-plausible score. Everything
// else stays locked down.
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidPlayerProfile(playerId) {
      let data = request.resource.data;
      return request.auth != null
        && request.auth.uid == playerId
        && data.keys().hasAll(['updatedAt'])
        && data.keys().hasOnly(['nickname', 'rating', 'updatedAt'])
        && (!('nickname' in data) || (data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 16))
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5000))
        && data.updatedAt is number;
    }

    // Nickname only — never a score source. Private to the owning player;
    // every leaderboard entry carries its own nickname copy for display.
    match /players/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow write: if isValidPlayerProfile(playerId);
    }

    function isValidLeaderboardEntry(playerId) {
      let data = request.resource.data;
      return request.auth != null
        && request.auth.uid == playerId
        && data.keys().hasOnly(['nickname', 'score', 'knowledgeIQ', 'updatedAt'])
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 16
        && data.score is number && data.score >= 0 && data.score <= 10000000
        && data.knowledgeIQ is number && data.knowledgeIQ >= 0 && data.knowledgeIQ <= 100
        && data.updatedAt is number;
    }

    match /leaderboard_alltime/{playerId} {
      allow read: if true;
      allow write: if isValidLeaderboardEntry(playerId);
    }

    match /leaderboard_daily/{dateKey}/entries/{playerId} {
      allow read: if true;
      allow write: if isValidLeaderboardEntry(playerId);
    }

    match /leaderboard_weekly/{weekKey}/entries/{playerId} {
      allow read: if true;
      allow write: if isValidLeaderboardEntry(playerId);
    }

    // Async 1v1: a challenge doc just pins down {mode, seed, options} plus
    // the creator's own already-played score — never a live score source,
    // so it's create-once/immutable rather than merge-updated like the
    // collections above.
    function isValidChallenge() {
      let data = request.resource.data;
      return request.auth != null
        && request.auth.uid == data.creatorId
        && data.keys().hasAll(['creatorId', 'creatorNickname', 'mode', 'seed', 'creatorScore', 'creatorKnowledgeIQ', 'createdAt'])
        && data.keys().hasOnly(['creatorId', 'creatorNickname', 'mode', 'seed', 'categoryId', 'level', 'creatorScore', 'creatorKnowledgeIQ', 'createdAt'])
        && data.creatorNickname is string && data.creatorNickname.size() > 0 && data.creatorNickname.size() <= 16
        && data.mode is string
        && data.seed is string && data.seed.size() > 0 && data.seed.size() <= 64
        && data.creatorScore is number && data.creatorScore >= 0 && data.creatorScore <= 10000000
        && data.creatorKnowledgeIQ is number && data.creatorKnowledgeIQ >= 0 && data.creatorKnowledgeIQ <= 100
        && data.createdAt is number;
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if isValidChallenge();
      allow update, delete: if false;
    }

    // Live 5-player match, same trust model as everything above (no Cloud
    // Functions re-derivation): any signed-in client may create/join a
    // lobby or advance its shared phase, guarded only by shape/type checks
    // and a few monotonicity constraints (status only moves forward,
    // currentQuestionIndex only steps forward by at most one at a time) —
    // enough to block an obviously malformed write, not to stop a
    // determined player from skipping ahead in their own match.
    function isValidLobbyShape(data) {
      return data.keys().hasAll(['status', 'seed', 'maxPlayers', 'playerCount', 'currentQuestionIndex', 'questionStartAt', 'countdownStartAt', 'createdAt'])
        && data.keys().hasOnly(['status', 'seed', 'categoryId', 'maxPlayers', 'playerCount', 'currentQuestionIndex', 'questionStartAt', 'countdownStartAt', 'createdAt'])
        && data.status in ['WAITING', 'COUNTDOWN', 'PLAYING', 'COMPLETE']
        && data.seed is string && data.seed.size() > 0 && data.seed.size() <= 64
        && data.maxPlayers is number && data.maxPlayers == 5
        && data.playerCount is number && data.playerCount >= 0 && data.playerCount <= 5
        && data.currentQuestionIndex is number && data.currentQuestionIndex >= 0 && data.currentQuestionIndex <= 20
        && (data.questionStartAt == null || data.questionStartAt is number)
        && (data.countdownStartAt == null || data.countdownStartAt is number)
        && data.createdAt is number;
    }

    function isValidStatusTransition(prevStatus, nextStatus) {
      return (prevStatus == 'WAITING' && (nextStatus == 'WAITING' || nextStatus == 'COUNTDOWN'))
        || (prevStatus == 'COUNTDOWN' && (nextStatus == 'COUNTDOWN' || nextStatus == 'PLAYING'))
        || (prevStatus == 'PLAYING' && (nextStatus == 'PLAYING' || nextStatus == 'COMPLETE'))
        || (prevStatus == 'COMPLETE' && nextStatus == 'COMPLETE');
    }

    match /championship_lobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && isValidLobbyShape(request.resource.data)
        && request.resource.data.status == 'WAITING'
        && request.resource.data.playerCount == 1
        && request.resource.data.currentQuestionIndex == 0
        && request.resource.data.questionStartAt == null
        && request.resource.data.countdownStartAt == null;
      allow update: if request.auth != null
        && isValidLobbyShape(request.resource.data)
        && isValidStatusTransition(resource.data.status, request.resource.data.status)
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.maxPlayers == resource.data.maxPlayers
        && request.resource.data.currentQuestionIndex >= resource.data.currentQuestionIndex
        && request.resource.data.currentQuestionIndex <= resource.data.currentQuestionIndex + 1;
      allow delete: if false;

      function isValidChampionshipPlayer() {
        let data = request.resource.data;
        return data.keys().hasOnly(['nickname', 'score', 'correctCount', 'lastAnsweredIndex', 'joinedAt'])
          && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 16
          && data.score is number && data.score >= 0 && data.score <= 10000000
          && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 20
          && data.lastAnsweredIndex is number && data.lastAnsweredIndex >= -1 && data.lastAnsweredIndex <= 20
          && data.joinedAt is number;
      }

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == playerId && isValidChampionshipPlayer();
        allow update: if request.auth != null && request.auth.uid == playerId && isValidChampionshipPlayer();
        allow delete: if request.auth != null && request.auth.uid == playerId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
