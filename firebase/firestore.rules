rules_version = '2';

// Cloud Functions (Admin SDK, bypasses these rules) would be the ideal write
// path for everything, but that needs the Blaze plan and isn't deployed —
// see docs/SECURITY.md. Until then, the leaderboard and player profile are
// written directly from the client (LeaderboardService/PlayerService), so
// THESE rules are the only validation those writes get: signed-in, own uid
// only, one bounded-shape doc per player per collection. This is a
// deliberate, accepted tradeoff (no server-side score re-derivation) — a
// determined client could still write a fake-but-plausible score. Everything
// else stays locked down.
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidPlayerProfile(playerId) {
      let data = request.resource.data;
      return request.auth != null
        && request.auth.uid == playerId
        && data.keys().hasOnly(['nickname', 'updatedAt'])
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 16
        && data.updatedAt is number;
    }

    // Nickname only — never a score source. Private to the owning player;
    // every leaderboard entry carries its own nickname copy for display.
    match /players/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow write: if isValidPlayerProfile(playerId);
    }

    function isValidLeaderboardEntry(playerId) {
      let data = request.resource.data;
      return request.auth != null
        && request.auth.uid == playerId
        && data.keys().hasOnly(['nickname', 'score', 'knowledgeIQ', 'updatedAt'])
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 16
        && data.score is number && data.score >= 0 && data.score <= 10000000
        && data.knowledgeIQ is number && data.knowledgeIQ >= 0 && data.knowledgeIQ <= 100
        && data.updatedAt is number;
    }

    match /leaderboard_alltime/{playerId} {
      allow read: if true;
      allow write: if isValidLeaderboardEntry(playerId);
    }

    match /leaderboard_daily/{dateKey}/entries/{playerId} {
      allow read: if true;
      allow write: if isValidLeaderboardEntry(playerId);
    }

    match /leaderboard_weekly/{weekKey}/entries/{playerId} {
      allow read: if true;
      allow write: if isValidLeaderboardEntry(playerId);
    }

    // Async 1v1: a challenge doc just pins down {mode, seed, options} plus
    // the creator's own already-played score — never a live score source,
    // so it's create-once/immutable rather than merge-updated like the
    // collections above.
    function isValidChallenge() {
      let data = request.resource.data;
      return request.auth != null
        && request.auth.uid == data.creatorId
        && data.keys().hasAll(['creatorId', 'creatorNickname', 'mode', 'seed', 'creatorScore', 'creatorKnowledgeIQ', 'createdAt'])
        && data.keys().hasOnly(['creatorId', 'creatorNickname', 'mode', 'seed', 'categoryId', 'level', 'creatorScore', 'creatorKnowledgeIQ', 'createdAt'])
        && data.creatorNickname is string && data.creatorNickname.size() > 0 && data.creatorNickname.size() <= 16
        && data.mode is string
        && data.seed is string && data.seed.size() > 0 && data.seed.size() <= 64
        && data.creatorScore is number && data.creatorScore >= 0 && data.creatorScore <= 10000000
        && data.creatorKnowledgeIQ is number && data.creatorKnowledgeIQ >= 0 && data.creatorKnowledgeIQ <= 100
        && data.createdAt is number;
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if isValidChallenge();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
