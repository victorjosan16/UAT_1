{
  "name": "tiny-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TINY TOWER — a minimalist, viral, precision-stacking arcade game.",
  "scripts": {
    "dev": "vite",
    "emulators": "firebase emulators:start --config firebase/firebase.json --project demo-tiny-tower",
    "dev:all": "concurrently -k \"npm:emulators\" \"npm:dev\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functions": "npm run --prefix firebase/functions test",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --prefix firebase/functions",
    "lint": "npm run typecheck",
    "deploy": "npm run build && firebase deploy --config firebase/firebase.json --only hosting,functions,firestore",
    "deploy:hosting": "npm run build && firebase deploy --config firebase/firebase.json --only hosting",
    "deploy:functions": "firebase deploy --config firebase/firebase.json --only functions",
    "deploy:firestore": "firebase deploy --config firebase/firebase.json --only firestore"
  },
  "dependencies": {
    "firebase": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "firebase-tools": "^13.28.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.8"
  }
}
